{
  "name": "qinxujunai.github.io",
  "private": true,
  "type": "module",
  "description": "秦徐俊的个人网站。纯静态，零运行时依赖。",
  "scripts": {
    "signature": "node scripts/signature.mjs",
    "check": "node scripts/check.mjs",
    "qa": "node scripts/qa.mjs",
    "serve": "npx --yes http-server . -p 4173 -c-1 -s",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "media": "node scripts/media.mjs",
    "stats": "node scripts/stats.mjs",
    "ship": "bash scripts/ship.sh",
    "lock": "node -e \"import('./scripts/copy-lock.mjs').then(async m=>{const {CASES}=await import('./src/cases.mjs');const P=['index.html','en/index.html','404.html',...CASES.flatMap(c=>['work/'+c.slug+'/index.html','en/work/'+c.slug+'/index.html'])];const r=m.checkCopy(P,'copy.lock.json',{write:true});r.forEach(x=>console.error(x));console.log('copy.lock.json written');process.exit(r.length?1:0)})\""
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "jsqr": "^1.4.0",
    "opentype.js": "^1.3.4",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5"
  }
}
